load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

cc_library(
    name = "ed25519_psa_driver",
    srcs = ["csrc/ed25519_psa_driver.c"],
    hdrs = [
        "csrc/ed25519_psa_driver.h",
    ],
    deps = ["//mbedtls-sys/vendor/mbedtls-4.0.0:mbedtls"],
    alwayslink = True,
)

rust_library(
    name = "mbedtls_sys",
    srcs = [
        "src/bindings.rs",
        "src/lib.rs",
    ],
    crate_name = "mbedtls_sys",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":ed25519_psa_driver"],
)
